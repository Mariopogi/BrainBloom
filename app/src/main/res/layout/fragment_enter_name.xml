<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1F18">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_flower_valley" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="28dp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="1"
            android:text="ADVENTURE MODE"
            android:textColor="#F4D84E"
            android:textSize="50sp"
            app:layout_constraintBottom_toTopOf="@+id/textEnterNameLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textEnterNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/arcade"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="ENTER YOUR NAME:"
            android:textColor="#F4D84E"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/editPlayerName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textTitle" />

        <EditText
            android:id="@+id/editPlayerName"
            android:layout_width="340dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bb_dialog_light"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:hint="PLAYER1"
            android:inputType="textCapCharacters"
            android:maxLength="10"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/bb_black"
            android:textColorHint="#99000000"
            android:textSize="26sp"
            app:layout_constraintBottom_toTopOf="@+id/buttonRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textEnterNameLabel" />

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editPlayerName">

            <Button
                android:id="@+id/buttonProceed"
                android:layout_width="160dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bb_button_green"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:stateListAnimator="@null"
                android:text="PROCEED"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/buttonBack"
                android:layout_width="160dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bb_button_red"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:stateListAnimator="@null"
                android:text="BACK"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>