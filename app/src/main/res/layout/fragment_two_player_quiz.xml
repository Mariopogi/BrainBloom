<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/twoPlayerQuizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mountain_blossom">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/screen_padding">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideLeftPanelEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.36" />

        <!-- TOP HUD BAR -->
        <LinearLayout
            android:id="@+id/twoPlayerTopHud"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:background="@drawable/bb_panel_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textQuizBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="DIFFICULTY: EASY"
                android:textColor="@color/bb_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform" />

            <ImageView
                android:id="@+id/imageHearts"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Hearts"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_3_hp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textTimer"
                android:layout_width="60dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bb_button_blue"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="30s"
                android:textColor="@color/bb_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/textCombo"
                android:layout_width="60dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bb_button_blue"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="COMBO&#10;0x"
                android:textColor="@color/bb_white"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/buttonPauseQuiz"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bb_panel_dark"
                android:contentDescription="Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_button_pause" />

        </LinearLayout>

        <!-- LEFT PANEL: player cards stacked -->
        <LinearLayout
            android:id="@+id/playerPanelColumn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideLeftPanelEnd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/twoPlayerTopHud">

            <!-- PLAYER 1 CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bb_panel_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Player 1"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bb_card_light"
                    android:padding="4dp"
                    android:src="@drawable/ic_crown_player_win" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="PLAYER 1"
                    android:textColor="@color/bb_yellow"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textPlayer1Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bb_card_light"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:padding="2dp"
                    android:text="Player 1"
                    android:textColor="@color/bb_black"
                    android:textSize="11sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="SCORE"
                    android:textColor="@color/bb_white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textPlayer1Score"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bb_card_light"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FF8847"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

            </LinearLayout>

            <!-- PLAYER 2 CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bb_panel_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Player 2"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bb_card_light"
                    android:padding="4dp"
                    android:src="@drawable/ic_crown_player_win"
                    android:alpha="0.4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="PLAYER 2"
                    android:textColor="@color/bb_yellow"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textPlayer2Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bb_card_light"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:padding="2dp"
                    android:text="Player 2"
                    android:textColor="@color/bb_black"
                    android:textSize="11sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="SCORE"
                    android:textColor="@color/bb_white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textPlayer2Score"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bb_card_light"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FF8847"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

            </LinearLayout>

        </LinearLayout>

        <!-- RIGHT PANEL: question number, question, answers (stacked vertically) -->
        <TextView
            android:id="@+id/textQuestionNumber"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bb_card_light"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="QUESTION 1 OUT 10"
            android:textColor="@color/bb_red"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/twoPlayerTopHud" />

        <TextView
            android:id="@+id/textQuestion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bb_card_light"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="4"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Which of these is NOT a part of a plant?"
            android:textColor="@color/bb_black"
            android:textSize="14sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/buttonChoiceA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/textQuestionNumber" />

        <!-- Answer buttons stacked vertically (per PDF) -->
        <Button
            android:id="@+id/buttonChoiceA"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bb_answer_a"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="A  Feather"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/buttonChoiceB"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/textQuestion"
            app:layout_constraintVertical_chainStyle="packed" />

        <Button
            android:id="@+id/buttonChoiceB"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bb_answer_b"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="B  Stem"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/buttonChoiceC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/buttonChoiceA" />

        <Button
            android:id="@+id/buttonChoiceC"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bb_answer_c"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="C  Root"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/buttonChoiceD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/buttonChoiceB" />

        <Button
            android:id="@+id/buttonChoiceD"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bb_answer_d"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="D  Leaf"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideLeftPanelEnd"
            app:layout_constraintTop_toBottomOf="@id/buttonChoiceC" />

        <!-- Hidden textProgress kept for Java reference -->
        <TextView
            android:id="@+id/textProgress"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>