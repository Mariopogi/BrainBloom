<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hanging_gardens"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/screen_padding">

    <ImageButton
        android:id="@+id/buttonLeaderboardBack"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:contentDescription="Back"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textLeaderboardTitle"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/medium_gap"
        android:background="@drawable/bb_top_strip"
        android:fontFamily="@font/arcade"
        android:gravity="center"
        android:includeFontPadding="true"
        android:text="LEADERBOARDS"
        android:textColor="@color/bb_yellow"
        android:textSize="@dimen/header_text_size"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/buttonLeaderboardBack"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/leaderboardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLeaderboardTitle">

        <LinearLayout
            android:id="@+id/singleLeaderboardCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bb_card_light"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bb_button_yellow"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="true"
                android:text="SINGLE"
                android:textColor="@color/bb_white"
                android:textSize="@dimen/body_text_size" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutSingleLeaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp" />

                </HorizontalScrollView>

            </ScrollView>

            <Button
                android:id="@+id/buttonResetSingle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bb_button_red"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="true"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="RESET"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="@dimen/small_text_size" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/twoPlayerLeaderboardCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bb_card_light"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bb_button_yellow"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="true"
                android:text="2 PLAYER"
                android:textColor="@color/bb_white"
                android:textSize="@dimen/body_text_size" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutTwoPlayerLeaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp" />

                </HorizontalScrollView>

            </ScrollView>

            <Button
                android:id="@+id/buttonResetTwoPlayer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bb_button_red"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="true"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="RESET"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="@dimen/small_text_size" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>