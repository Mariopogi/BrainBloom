<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/confirmNavigationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/confirmNavigationDialog"
        android:layout_width="580dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bb_dialog_light"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp"
        android:paddingBottom="26dp">

        <ImageView
            android:id="@+id/imgWarning"
            android:layout_width="78dp"
            android:layout_height="68dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/txtConfirmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Are you sure you want to go back?"
            android:textColor="#000000"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="true"
            android:lineSpacingExtra="4dp"
            android:text="No score will be recorded if the book is not successfully completed. Complete the book so the score will be recorded."
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="italic" />

        <LinearLayout
            android:id="@+id/confirmButtonRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConfirmAction"
                android:layout_width="205dp"
                android:layout_height="50dp"
                android:background="@drawable/bb_button_red"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="GO BACK"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="26dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnCancelConfirmNavigation"
                android:layout_width="205dp"
                android:layout_height="50dp"
                android:background="@drawable/bb_button_gray"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="CANCEL"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>