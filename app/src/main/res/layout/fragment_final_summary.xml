<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/finalSummaryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mountain_blossom"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/imageFinalBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="Completed badge"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_completed_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textFinalTitle"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/arcade"
        android:gravity="center"
        android:includeFontPadding="false"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0.5"
        android:text="THANK YOU, GARDEN SAVIOR!"
        android:textColor="@color/bb_yellow"
        android:textSize="28sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="28sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageFinalBadge" />

    <TextView
        android:id="@+id/textFinalSubtitle"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="60dp"
        android:fontFamily="@font/arcade"
        android:gravity="center"
        android:includeFontPadding="false"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="1.2"
        android:text="Your knowledge brought life back the garden!"
        android:textColor="@color/bb_white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textFinalTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/finalPanel"
        android:layout_width="380dp"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bb_card_light"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textFinalSubtitle">

        <TextView
            android:id="@+id/textBooksRestoredLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/arcade"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:text="BOOKS RESTORED:"
            android:textColor="@color/bb_black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textTotalTimeLeftLabel"
            app:layout_constraintEnd_toStartOf="@id/textBooksRestoredValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread" />

        <TextView
            android:id="@+id/textBooksRestoredValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:text="4/4"
            android:textColor="#3A9846"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/textBooksRestoredLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textBooksRestoredLabel" />

        <TextView
            android:id="@+id/textTotalTimeLeftLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/arcade"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:text="TOTAL TIME LEFT:"
            android:textColor="@color/bb_black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textHighestComboLabel"
            app:layout_constraintEnd_toStartOf="@id/textTotalTimeLeftValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textBooksRestoredLabel" />

        <TextView
            android:id="@+id/textTotalTimeLeftValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:text="120s"
            android:textColor="#3A9846"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/textTotalTimeLeftLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textTotalTimeLeftLabel" />

        <TextView
            android:id="@+id/textHighestComboLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/arcade"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:text="HIGHEST COMBO:"
            android:textColor="@color/bb_black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textOverallScoreLabel"
            app:layout_constraintEnd_toStartOf="@id/textHighestComboValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTotalTimeLeftLabel" />

        <TextView
            android:id="@+id/textHighestComboValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:text="5x"
            android:textColor="#3A9846"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/textHighestComboLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textHighestComboLabel" />

        <TextView
            android:id="@+id/textOverallScoreLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/arcade"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:text="OVERALL SCORE:"
            android:textColor="@color/bb_black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textOverallScoreValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textHighestComboLabel" />

        <TextView
            android:id="@+id/textOverallScoreValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:text="4100"
            android:textColor="#FF8847"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/textOverallScoreLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textOverallScoreLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/finalButtonRow"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/finalPanel">

        <Button
            android:id="@+id/buttonFinalPlayAgain"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bb_button_green"
            android:backgroundTint="@null"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:stateListAnimator="@null"
            android:text="PLAY AGAIN"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeTextType="uniform" />

        <Button
            android:id="@+id/buttonFinalMainMenu"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bb_button_gray"
            android:backgroundTint="@null"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:stateListAnimator="@null"
            android:text="MAIN MENU"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeTextType="uniform" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>