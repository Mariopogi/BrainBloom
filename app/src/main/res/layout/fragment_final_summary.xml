<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/finalSummaryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mountain_blossom"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/imageFinalBadge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:adjustViewBounds="true"
        android:contentDescription="Completed badge"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_completed_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textFinalTitle"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/arcade"
        android:gravity="center"
        android:includeFontPadding="false"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0.5"
        android:text="THANK YOU, GARDEN SAVIOR!"
        android:textColor="@color/bb_yellow"
        android:textSize="28sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="28sp"
        app:autoSizeMinTextSize="18sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageFinalBadge" />

    <TextView
        android:id="@+id/textFinalSubtitle"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="80dp"
        android:fontFamily="sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:shadowColor="#1A2633"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="1.5"
        android:text="Your knowledge brought life back the garden!"
        android:textColor="@color/bb_white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textFinalTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/finalPanel"
        android:layout_width="400dp"
        android:layout_height="156dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bb_card_light"
        android:paddingStart="30dp"
        android:paddingTop="14dp"
        android:paddingEnd="30dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textFinalSubtitle">

        <ImageView
            android:id="@+id/imageBooksRestored"
            android:layout_width="72dp"
            android:layout_height="58dp"
            android:adjustViewBounds="true"
            android:contentDescription="Books restored"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_book_restored"
            app:layout_constraintBottom_toTopOf="@id/imageOverallScore"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <ImageView
            android:id="@+id/imageOverallScore"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="Overall score"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_overall_score"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/imageBooksRestored"
            app:layout_constraintStart_toStartOf="@id/imageBooksRestored"
            app:layout_constraintTop_toBottomOf="@id/imageBooksRestored" />

        <TextView
            android:id="@+id/textBooksRestoredLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="BOOKS RESTORED"
            android:textColor="@color/bb_black"
            android:textSize="21sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="21sp"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/textBooksRestoredValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageBooksRestored"
            app:layout_constraintTop_toTopOf="@id/imageBooksRestored"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textBooksRestoredValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="4/4"
            android:textColor="#3A9846"
            android:textSize="36sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="36sp"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@id/imageBooksRestored"
            app:layout_constraintEnd_toEndOf="@id/textBooksRestoredLabel"
            app:layout_constraintStart_toStartOf="@id/textBooksRestoredLabel"
            app:layout_constraintTop_toBottomOf="@id/textBooksRestoredLabel" />

        <TextView
            android:id="@+id/textOverallScoreLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="OVERALL SCORE"
            android:textColor="@color/bb_black"
            android:textSize="21sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="21sp"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/textOverallScoreValue"
            app:layout_constraintEnd_toEndOf="@id/textBooksRestoredLabel"
            app:layout_constraintStart_toStartOf="@id/textBooksRestoredLabel"
            app:layout_constraintTop_toTopOf="@id/imageOverallScore"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textOverallScoreValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="4100"
            android:textColor="#FF8847"
            android:textSize="36sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="36sp"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@id/imageOverallScore"
            app:layout_constraintEnd_toEndOf="@id/textOverallScoreLabel"
            app:layout_constraintStart_toStartOf="@id/textOverallScoreLabel"
            app:layout_constraintTop_toBottomOf="@id/textOverallScoreLabel" />

        <TextView
            android:id="@+id/textFinalStats"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="Books Restored: 4&#10;Overall Score: 4100"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/finalButtonRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="110dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="110dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/finalPanel">

        <Button
            android:id="@+id/buttonFinalPlayAgain"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bb_button_green"
            android:backgroundTint="@null"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="PLAY AGAIN"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonFinalMainMenu"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bb_button_gray"
            android:backgroundTint="@null"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="MAIN MENU"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>