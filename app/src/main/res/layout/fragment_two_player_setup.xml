<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_flower_valley" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/textTwoPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="1"
                android:text="2 PLAYER MODE"
                android:textColor="@color/bb_yellow"
                android:textSize="32sp" />

            <!-- PLAYER CARDS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- PLAYER 1 CARD — BLUE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@color/bb_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/arcade"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="PLAYER 1"
                            android:textColor="#FFD700"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/editPlayerOneName"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#AA000000"
                            android:fontFamily="@font/arcade"
                            android:gravity="center"
                            android:hint="Player 1"
                            android:includeFontPadding="false"
                            android:inputType="textPersonName"
                            android:maxLength="16"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#AAAAAA"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_player"/>

                </LinearLayout>

                <!-- PLAYER 2 CARD — RED -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@color/bb_red"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/arcade"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="PLAYER 2"
                            android:textColor="#FFD700"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/editPlayerTwoName"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="#AA000000"
                            android:fontFamily="@font/arcade"
                            android:gravity="center"
                            android:hint="Player 2"
                            android:includeFontPadding="false"
                            android:inputType="textPersonName"
                            android:maxLength="16"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#AAAAAA"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Person silhouette box -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_player"/>

                </LinearLayout>

            </LinearLayout>

            <!-- DIFFICULTY PANEL — wrap_content so it centers naturally -->
            <LinearLayout
                android:layout_width="500dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bb_button_green"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingTop="12dp"
                android:paddingEnd="36dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arcade"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="DIFFICULTY"
                    android:textColor="@color/bb_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioEasy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/bb_white"
                        android:checked="true"
                        android:fontFamily="@font/arcade"
                        android:paddingStart="4dp"
                        android:paddingEnd="16dp"
                        android:text="Easy"
                        android:textColor="@color/bb_white"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/bb_white"
                        android:fontFamily="@font/arcade"
                        android:paddingStart="4dp"
                        android:paddingEnd="16dp"
                        android:text="Medium"
                        android:textColor="@color/bb_white"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioHard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/bb_white"
                        android:fontFamily="@font/arcade"
                        android:paddingStart="4dp"
                        android:text="Hard"
                        android:textColor="@color/bb_white"
                        android:textSize="14sp" />

                </RadioGroup>

            </LinearLayout>

            <!-- START MATCH — fixed centered width -->
            <Button
                android:id="@+id/buttonStartTwoPlayerMatch"
                android:layout_width="500dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bb_button_purple"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="START MATCH"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- MAIN MENU — fixed centered width -->
            <Button
                android:id="@+id/buttonTwoPlayerBack"
                android:layout_width="500dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bb_panel_dark"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="MAIN MENU"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>