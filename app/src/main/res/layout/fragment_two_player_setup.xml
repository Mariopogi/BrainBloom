<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_flower_valley" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/textTwoPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="1"
            android:text="2 PLAYER MODE"
            android:textColor="@color/bb_yellow"
            android:textSize="36sp"
            app:autoSizeMaxTextSize="36sp"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- PLAYER CARDS ROW -->
        <LinearLayout
            android:id="@+id/playerCardsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTwoPlayerTitle">

            <!-- PLAYER 1 CARD (blue) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bb_panel_dark"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="PLAYER 1"
                        android:textColor="@color/bb_yellow"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editPlayerOneName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bb_card_light"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:hint="Player 1"
                        android:includeFontPadding="false"
                        android:inputType="textPersonName"
                        android:maxLength="16"
                        android:singleLine="true"
                        android:textColor="@color/bb_black"
                        android:textColorHint="@color/bb_gray"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bb_card_light"
                    android:contentDescription="Player 1 avatar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_crown_player_win" />

            </LinearLayout>

            <!-- PLAYER 2 CARD (red) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bb_panel_dark"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="PLAYER 2"
                        android:textColor="@color/bb_yellow"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editPlayerTwoName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bb_card_light"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:hint="Player 2"
                        android:includeFontPadding="false"
                        android:inputType="textPersonName"
                        android:maxLength="16"
                        android:singleLine="true"
                        android:textColor="@color/bb_black"
                        android:textColorHint="@color/bb_gray"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bb_card_light"
                    android:contentDescription="Player 2 avatar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_crown_player_win" />

            </LinearLayout>

        </LinearLayout>

        <!-- DIFFICULTY PANEL -->
        <LinearLayout
            android:id="@+id/difficultyPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bb_button_green"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playerCardsRow">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="DIFFICULTY"
                android:textColor="@color/bb_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioEasy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/bb_white"
                    android:checked="true"
                    android:fontFamily="@font/arcade"
                    android:paddingStart="6dp"
                    android:paddingEnd="16dp"
                    android:text="Easy"
                    android:textColor="@color/bb_white"
                    android:textSize="@dimen/body_text_size" />

                <RadioButton
                    android:id="@+id/radioMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/bb_white"
                    android:fontFamily="@font/arcade"
                    android:paddingStart="6dp"
                    android:paddingEnd="16dp"
                    android:text="Medium"
                    android:textColor="@color/bb_white"
                    android:textSize="@dimen/body_text_size" />

                <RadioButton
                    android:id="@+id/radioHard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/bb_white"
                    android:fontFamily="@font/arcade"
                    android:paddingStart="6dp"
                    android:text="Hard"
                    android:textColor="@color/bb_white"
                    android:textSize="@dimen/body_text_size" />

            </RadioGroup>
        </LinearLayout>

        <!-- START MATCH BUTTON -->
        <Button
            android:id="@+id/buttonStartTwoPlayerMatch"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="14dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bb_button_purple"
            android:fontFamily="@font/arcade"
            android:includeFontPadding="false"
            android:text="START MATCH"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/difficultyPanel" />

        <!-- MAIN MENU BUTTON -->
        <Button
            android:id="@+id/buttonTwoPlayerBack"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bb_panel_dark"
            android:fontFamily="@font/arcade"
            android:includeFontPadding="false"
            android:text="MAIN MENU"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonStartTwoPlayerMatch" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>