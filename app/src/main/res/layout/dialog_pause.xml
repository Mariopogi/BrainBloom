<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pauseDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/pauseDialogContainer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bb_dialog_light"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/textPauseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/pause"
            android:textColor="@color/bb_black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonPauseResume"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bb_button_green"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/resume"
            android:textColor="@color/bb_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonPauseRestart"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bb_button_orange"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/restart"
            android:textColor="@color/bb_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonPauseMainMenu"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bb_button_gray"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/main_menu"
            android:textColor="@color/bb_white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>