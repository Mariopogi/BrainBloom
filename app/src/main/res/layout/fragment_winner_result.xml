<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_pastel_sky" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- STAR BADGE -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:adjustViewBounds="true"
                android:contentDescription="Winner star"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_completed_badge" />

            <!-- WINNER TITLE -->
            <TextView
                android:id="@+id/textWinnerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="1"
                android:text="PLAYER 1 WINS!"
                android:textColor="@color/bb_yellow"
                android:textSize="32sp"
                app:autoSizeMaxTextSize="32sp"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeTextType="uniform" />

            <!-- PLAYER 1 CARD — YELLOW/GOLD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFD700"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Crown icon -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Crown"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_crown_player_win" />

                <!-- Stats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arcade"
                        android:includeFontPadding="false"
                        android:text="PLAYER 1"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textWinnerP1Stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/arcade"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:text="SCORE     0&#10;TIME      0s&#10;COMBO     0x"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

                <!-- Avatar + name -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Person icon white box -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_player"/>

                    <TextView
                        android:id="@+id/textWinnerP1Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#AA000000"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="3dp"
                        android:text="Mario"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

            </LinearLayout>

            <!-- PLAYER 2 CARD — CREAM/BEIGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F5F0DC"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Dimmed placeholder left -->
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.3"
                    android:background="#AAAAAA"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="26sp" />

                </LinearLayout>

                <!-- Stats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arcade"
                        android:includeFontPadding="false"
                        android:text="PLAYER 2"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textWinnerP2Stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/arcade"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:text="SCORE     0&#10;TIME      0s&#10;COMBO     0x"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

                <!-- Avatar + name -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_player"/>

                    <TextView
                        android:id="@+id/textWinnerP2Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#AA000000"
                        android:fontFamily="@font/arcade"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="3dp"
                        android:text="Trisha"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

            </LinearLayout>

            <!-- Hidden for legacy Java reference -->
            <TextView
                android:id="@+id/textWinnerStats"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <!-- BUTTONS -->
            <LinearLayout
                android:id="@+id/winnerButtonRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonWinnerPlayAgain"
                    android:layout_width="200dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bb_button_green"
                    android:fontFamily="@font/arcade"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/play_again"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_white"
                    android:textSize="@dimen/button_text_size" />

                <Button
                    android:id="@+id/buttonWinnerMainMenu"
                    android:layout_width="200dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bb_button_gray"
                    android:fontFamily="@font/arcade"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/main_menu"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_white"
                    android:textSize="@dimen/button_text_size" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</ScrollView>