<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hanging_gardens">

    <ImageButton
        android:id="@+id/buttonSettingsBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Back"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="12dp" />

    <TextView
        android:id="@+id/textSettingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arcade"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/settings"
        android:textColor="@color/bb_yellow"
        android:textSize="@dimen/title_text_size"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp" />

    <!-- SOUNDS ROW -->
    <LinearLayout
        android:id="@+id/soundsRow"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bb_panel_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSettingsTitle">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Sound icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_decrease_sound"
            android:layout_marginEnd="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:includeFontPadding="false"
            android:text="SOUNDS"
            android:textColor="@color/bb_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="14dp" />

        <TextView
            android:id="@+id/textSoundLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="|||||"
            android:textColor="@color/bb_green"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/buttonSoundMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_decrease_sound" />

        <ImageButton
            android:id="@+id/buttonSoundPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_increase_sound" />

    </LinearLayout>

    <!-- MUSIC ROW -->
    <LinearLayout
        android:id="@+id/musicRow"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bb_panel_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/soundsRow">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Music icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_increase_sound"
            android:layout_marginEnd="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arcade"
            android:includeFontPadding="false"
            android:text="MUSIC"
            android:textColor="@color/bb_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="14dp" />

        <TextView
            android:id="@+id/textMusicLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="|||||"
            android:textColor="@color/bb_green"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/buttonMusicMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_decrease_sound" />

        <ImageButton
            android:id="@+id/buttonMusicPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_increase_sound" />

    </LinearLayout>

    <!-- EXPORT LEADERBOARD BUTTON -->
    <Button
        android:id="@+id/buttonExportLeaderboard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bb_button_green"
        android:fontFamily="@font/arcade"
        android:includeFontPadding="false"
        android:text="EXPORT LEADERBOARD"
        android:textAllCaps="false"
        android:textColor="@color/bb_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/musicRow" />

</androidx.constraintlayout.widget.ConstraintLayout>