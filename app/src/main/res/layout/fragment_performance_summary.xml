<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/performanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floral_field"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/buttonPerformanceBack"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_button_back"
            app:layout_constraintBottom_toBottomOf="@id/textPerformanceTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textPerformanceTitle" />

        <TextView
            android:id="@+id/textPerformanceTitle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bb_top_strip"
            android:fontFamily="@font/arcade"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="BOOK COMPLETED!"
            android:textColor="@color/bb_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/performanceCard"
            android:layout_width="0dp"
            android:layout_height="165dp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bb_card_light"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="34dp"
            android:paddingTop="14dp"
            android:paddingEnd="34dp"
            android:paddingBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textPerformanceTitle">

            <TextView
                android:id="@+id/textPerformanceSummaryTitle"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="PERFORMANCE SUMMARY"
                android:textColor="@color/bb_black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Row 1: Time Left -->
            <TextView
                android:id="@+id/textTimeLeftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="TIME LEFT:"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/textCorrectLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textPerformanceSummaryTitle"
                app:layout_constraintVertical_chainStyle="spread" />

            <TextView
                android:id="@+id/textTimeLeftValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="211s"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/textTimeLeftLabel"
                app:layout_constraintStart_toEndOf="@id/textTimeLeftLabel"
                app:layout_constraintTop_toTopOf="@id/textTimeLeftLabel" />

            <!-- Row 2: Correct Answers -->
            <TextView
                android:id="@+id/textCorrectLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="CORRECT ANSWERS:"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/textComboLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textTimeLeftLabel" />

            <TextView
                android:id="@+id/textCorrectValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="8"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/textCorrectLabel"
                app:layout_constraintStart_toEndOf="@id/textCorrectLabel"
                app:layout_constraintTop_toTopOf="@id/textCorrectLabel" />

            <!-- Row 3: Highest Combo -->
            <TextView
                android:id="@+id/textComboLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="HIGHEST COMBO:"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/textScoreLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textCorrectLabel" />

            <TextView
                android:id="@+id/textComboValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="4x"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/textComboLabel"
                app:layout_constraintStart_toEndOf="@id/textComboLabel"
                app:layout_constraintTop_toTopOf="@id/textComboLabel" />

            <!-- Row 4: Score -->
            <TextView
                android:id="@+id/textScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="SCORE:"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textComboLabel" />

            <TextView
                android:id="@+id/textScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/arcade"
                android:includeFontPadding="false"
                android:text="1065"
                android:textColor="@color/bb_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/textScoreLabel"
                app:layout_constraintStart_toEndOf="@id/textScoreLabel"
                app:layout_constraintTop_toTopOf="@id/textScoreLabel" />

            <FrameLayout
                android:id="@+id/imagePerformancePanel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bb_panel_light_rect"
                android:padding="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textPerformanceSummaryTitle"
                app:layout_constraintWidth_percent="0.32">

                <ImageView
                    android:id="@+id/imagePerformanceObject"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Completed object"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_book1_pink_flower" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/performanceButtonRow"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/performanceCard">

            <Button
                android:id="@+id/buttonNextBook"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:background="@drawable/bb_button_green"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="NEXT BOOK"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>