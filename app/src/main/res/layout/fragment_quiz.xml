<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floral_field">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quizContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/quizTopPanel"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:background="@drawable/bb_panel_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textQuizBook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="BOOK 1:\nTHE FLOWER FIELD"
                android:textColor="@color/bb_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform" />

            <ImageView
                android:id="@+id/imageHearts"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Hearts"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_3_hp" />

            <TextView
                android:id="@+id/textTimer"
                android:layout_width="64dp"
                android:layout_height="42dp"
                android:background="@drawable/bb_button_blue"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="30s"
                android:textColor="@color/bb_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/textCombo"
                android:layout_width="64dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bb_button_blue"
                android:fontFamily="@font/arcade"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="COMBO\n1x"
                android:textColor="@color/bb_white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="10sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeTextType="uniform" />

            <ImageButton
                android:id="@+id/buttonPauseQuiz"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:contentDescription="Pause"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_button_pause" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/questionPanel"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bb_card_light"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quizTopPanel">

            <TextView
                android:id="@+id/textQuestionNumber"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="QUESTION 1 OUT 10"
                android:textColor="@color/bb_red"
                android:textSize="12sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/textQuestion"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="IF 5X + 3 = 18, WHAT IS X?"
                android:textColor="@color/bb_black"
                android:textSize="15sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

        <GridLayout
            android:id="@+id/answerGrid"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginTop="6dp"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionPanel">

            <Button
                android:id="@+id/buttonChoiceA"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bb_answer_a"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="A    2"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

            <Button
                android:id="@+id/buttonChoiceC"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bb_answer_c"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="C    3"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

            <Button
                android:id="@+id/buttonChoiceB"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bb_answer_b"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="B    3"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

            <Button
                android:id="@+id/buttonChoiceD"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bb_answer_d"
                android:backgroundTint="@null"
                android:fontFamily="@font/arcade"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="D    5"
                android:textAllCaps="false"
                android:textColor="@color/bb_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />

        </GridLayout>

        <TextView
            android:id="@+id/textProgress"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bb_panel_dark"
            android:fontFamily="@font/arcade"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="PROGRESS 0/10\nANSWER 7 CORRECTLY TO RESTORE THE BOOK"
            android:textColor="@color/bb_white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeMinTextSize="7sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>